{
    "version": 2,
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "builds": [
      {
        "src": "server/express.js",
        "use": "@vercel/node"
      },
      {
        "src": "client/package.json",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "dist"
        }
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "server/express.js"
      },
      {
        "src": "/auth/(.*)",
        "dest": "server/express.js"
      },
      {
        "src": "/(?!api|auth).*",
      "dest": "/index.html"
      }
    ]
    
}